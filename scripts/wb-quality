#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
"""White balance quality: what a DNG says about its own white balance.

Prints the tags the white balance rests on (AsShotNeutral, the camera matrices with their
calibration illuminants, the embedded profile) and the rawr: ambient values the capture
recorded, then the CCT that AsShotNeutral implies through the camera matrices and the mired
error against the illuminant the scene was lit by.

  scripts/wb-quality capture.dng --reference 5600
  scripts/wb-quality *.dng --json

Two errors are separated, which is the point of the procedure in docs/white-balance-quality.md:

  neutral error  AsShotNeutral against the reference: the seed (sensor CCT, its mired
                 correction) and the gains, i.e. what the camera asked the converter to do.
                 The sensor's own reading travels in rawr:AmbientColorTemperature, so the
                 script also prints the error of that reading alone: +9 mired there with a
                 neutral error near 0 means the correction did its job, a non-zero neutral
                 error means the gains did not follow the seed.
  patch error    not here: the payload is lossless JPEG, so the gray card's neutrality has to
                 be read in a converter that honours AsShotNeutral.

Camera space illuminant = 1 / AsShotNeutral (the DNG adapter writes 1/gain there), fed through
the inverse ColorMatrix to XYZ and reduced to CCT with McCamy's approximation, which is a
handful of mired near the Planckian locus and only a pointer far from it.
"""

import argparse
import json
import math
import struct
import sys
from pathlib import Path

AS_SHOT_NEUTRAL = 50728
COLOR_MATRIX_1 = 50721
COLOR_MATRIX_2 = 50722
CALIBRATION_ILLUMINANT_1 = 50778
CALIBRATION_ILLUMINANT_2 = 50779
FORWARD_MATRIX_1 = 50964
FORWARD_MATRIX_2 = 50965
PROFILE_NAME = 50936
UNIQUE_CAMERA_MODEL = 50708
DNG_VERSION = 50706
IMAGE_WIDTH = 256
IMAGE_LENGTH = 257
MAKE = 271
MODEL = 272
XMP = 700

TYPE_SIZES = {1: 1, 2: 1, 3: 2, 4: 4, 5: 8, 6: 1, 7: 1, 8: 2, 9: 4, 10: 8, 11: 4, 12: 8}

ILLUMINANT_NAMES = {
    0: "unknown", 1: "daylight", 2: "fluorescent", 3: "tungsten", 4: "flash", 9: "fine weather",
    11: "cloudy", 12: "daylight fluorescent", 13: "day white fluorescent",
    14: "cool white fluorescent", 15: "white fluorescent", 17: "standard light A",
    18: "standard light B", 19: "standard light C", 20: "D55", 21: "D65", 22: "D75",
    23: "D50", 24: "ISO studio tungsten", 255: "other",
}
# Nominal CCT of the calibration illuminants a DNG may carry (used to pick the nearer matrix).
ILLUMINANT_CCT = {17: 2856, 18: 4870, 19: 6770, 20: 5500, 21: 6504, 22: 7500, 23: 5003, 24: 3200}

# rawr: XMP attributes written by |app/src/main/cpp/metadata/AmbientMetadata.h|.
RAWR_ATTRIBUTES = {
    "rawr:AmbientLux": "lux",
    "rawr:AmbientColorTemperature": "cctK",
    "rawr:LightFlicker": "flickerHz",
    "rawr:TofDistance": "tofDistanceM",
}


def mired(kelvin):
    return 1.0e6 / kelvin if kelvin > 0 else float("nan")


def cct_from_xy(x, y):
    # McCamy (1992). Good to a few mired within a few hundred kelvin of the locus.
    n = (x - 0.3320) / (y - 0.1858)
    return 437.0 * n**3 + 3601.0 * n**2 + 6861.0 * n + 5513.0


def invert3(m):
    a, b, c, d, e, f, g, h, i = m
    det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
    if abs(det) < 1.0e-12:
        raise ValueError("camera matrix is singular")
    return [
        (e * i - f * h) / det, (c * h - b * i) / det, (b * f - c * e) / det,
        (f * g - d * i) / det, (a * i - c * g) / det, (c * d - a * f) / det,
        (d * h - e * g) / det, (b * g - a * h) / det, (a * e - b * d) / det,
    ]


def mul3(m, v):
    return [m[0] * v[0] + m[1] * v[1] + m[2] * v[2],
            m[3] * v[0] + m[4] * v[1] + m[5] * v[2],
            m[6] * v[0] + m[7] * v[1] + m[8] * v[2]]


def neutral_cct(neutral, matrix):
    """CCT of the light that the neutral point implies, through a camera matrix (XYZ -> camera)."""
    light = [1.0 / n if n > 1.0e-9 else 0.0 for n in neutral]
    g = light[1]
    if g <= 0:
        raise ValueError("AsShotNeutral has no green")
    light = [x / g for x in light]
    xyz = mul3(invert3(matrix), light)
    total = sum(xyz)
    if total <= 0:
        raise ValueError("camera matrix maps the neutral outside any visible colour")
    x, y = xyz[0] / total, xyz[1] / total
    return cct_from_xy(x, y), x, y


def _decode(typ, count, bo, raw):
    if typ == 2:
        return raw.decode("ascii", "replace").rstrip("\x00")
    if typ in (1, 6, 7):
        return list(raw)
    if typ == 3:
        fmt = "H"
    elif typ in (4, 9, 13):
        fmt = "I"
    elif typ == 8:
        fmt = "h"
    elif typ == 5:
        return [n / d if d else float("nan") for n, d in
                (struct.unpack_from(bo + "II", raw, i * 8) for i in range(count))]
    elif typ == 10:
        return [n / d if d else float("nan") for n, d in
                (struct.unpack_from(bo + "ii", raw, i * 8) for i in range(count))]
    elif typ == 11:
        fmt = "f"
    elif typ == 12:
        fmt = "d"
    else:
        return list(raw)
    return list(struct.unpack(bo + fmt * count, raw[: struct.calcsize(fmt) * count]))


def _parse_ifd(data, offset, bo):
    count = struct.unpack_from(bo + "H", data, offset)[0]
    tags = {}
    for i in range(count):
        entry = offset + 2 + i * 12
        tag, typ, n = struct.unpack_from(bo + "HHI", data, entry)
        size = TYPE_SIZES.get(typ, 0) * n
        if size <= 4:
            raw = data[entry + 8: entry + 8 + size]
        else:
            start = struct.unpack_from(bo + "I", data, entry + 8)[0]
            raw = data[start: start + size]
        try:
            tags[tag] = _decode(typ, n, bo, raw)
        except (struct.error, ValueError):
            pass
    nxt = struct.unpack_from(bo + "I", data, offset + 2 + count * 12)[0]
    return tags, nxt


def read_dng(path):
    """All the tags the white balance needs, merged across IFD0, the next IFDs and the sub-IFDs."""
    data = path.read_bytes()
    order = data[:2]
    if order not in (b"II", b"MM"):
        raise ValueError(f"{path}: not a TIFF/DNG ({order!r})")
    bo = "<" if order == b"II" else ">"
    tags, merged = {}, 0
    pending, seen = [struct.unpack_from(bo + "I", data, 4)[0]], set()
    while pending:
        offset = pending.pop(0)
        if not offset or offset in seen or offset >= len(data):
            continue
        seen.add(offset)
        ifd, nxt = _parse_ifd(data, offset, bo)
        merged += 1
        for tag, values in ifd.items():
            # First IFD that carries a tag wins: IFD0 holds the model and the XMP packet, the
            # raw sub-IFD holds the colour tags, and neither should overwrite the other.
            tags.setdefault(tag, values)
        for pointer in list(ifd.get(330, []) or []) + [nxt]:
            if pointer:
                pending.append(pointer)
    if merged == 0:
        raise ValueError(f"{path}: no image file directory")
    return tags


def rawr_xmp(text):
    values = {}
    for attribute, key in RAWR_ATTRIBUTES.items():
        marker = attribute + '="'
        start = text.find(marker)
        if start < 0:
            continue
        start += len(marker)
        end = text.find('"', start)
        try:
            values[key] = float(text[start:end])
        except ValueError:
            pass
    return values


def report(path, reference):
    tags = read_dng(path)
    xmp = ""
    if XMP in tags:
        raw = tags[XMP]
        xmp = raw if isinstance(raw, str) else "".join(chr(b) for b in raw)
    ambient = rawr_xmp(xmp)

    out = {
        "file": path.name,
        "model": tags.get(UNIQUE_CAMERA_MODEL) or tags.get(MODEL) or tags.get(MAKE) or "?",
        "size": f"{tags.get(IMAGE_WIDTH, ['?'])[0]}x{tags.get(IMAGE_LENGTH, ['?'])[0]}",
        "asShotNeutral": tags.get(AS_SHOT_NEUTRAL),
        "matrix1": tags.get(COLOR_MATRIX_1),
        "matrix2": tags.get(COLOR_MATRIX_2),
        "illuminant1": tags.get(CALIBRATION_ILLUMINANT_1, [None])[0],
        "illuminant2": tags.get(CALIBRATION_ILLUMINANT_2, [None])[0],
        "profileName": tags.get(PROFILE_NAME, [None])[0],
        "ambient": ambient,
        "reference": reference,
    }

    neutral = tags.get(AS_SHOT_NEUTRAL)
    if neutral and len(neutral) >= 3:
        estimates = []
        for key, illum_key in (("matrix1", "illuminant1"), ("matrix2", "illuminant2")):
            matrix = tags.get(COLOR_MATRIX_1 if key == "matrix1" else COLOR_MATRIX_2)
            if not matrix or len(matrix) < 9:
                continue
            try:
                cct, x, y = neutral_cct(neutral[:3], matrix)
            except (ValueError, ZeroDivisionError):
                continue
            illum = out[illum_key]
            nominal = ILLUMINANT_CCT.get(illum)
            estimates.append({
                "matrix": key,
                "cctK": round(cct),
                "xy": [round(x, 5), round(y, 5)],
                "illuminant": ILLUMINANT_NAMES.get(illum, illum),
                "illuminantK": nominal,
                "miredToIlluminant": round(abs(mired(cct) - mired(nominal))) if nominal else None,
            })
        out["neutral"] = estimates
        if estimates:
            near = [e for e in estimates if e["miredToIlluminant"] is not None]
            chosen = min(near, key=lambda e: e["miredToIlluminant"]) if near else estimates[0]
            chosen["chosen"] = True
            out["neutralK"] = chosen["cctK"]
            out["neutralMired"] = round(mired(chosen["cctK"]), 1)

    if reference:
        out["referenceK"] = reference
        out["referenceMired"] = round(mired(reference), 1)
        if out.get("neutralMired") is not None:
            out["neutralErrorMired"] = round(out["neutralMired"] - out["referenceMired"], 1)
        if "cctK" in ambient:
            out["sensorErrorMired"] = round(mired(ambient["cctK"]) - out["referenceMired"], 1)
    return out


def print_report(r):
    print(f"{r['file']}  {r['size']}  {r['model']}")
    if r["asShotNeutral"]:
        n = r["asShotNeutral"]
        print(f"  AsShotNeutral                {n[0]:.5f} {n[1]:.5f} {n[2]:.5f}")
    else:
        print("  AsShotNeutral                absent")
    for key, illum_key in (("matrix1", "illuminant1"), ("matrix2", "illuminant2")):
        if r[key]:
            illum = r[illum_key]
            name = ILLUMINANT_NAMES.get(illum, illum)
            nominal = ILLUMINANT_CCT.get(illum)
            print(f"  {key}                       {name}" + (f" ({nominal} K)" if nominal else ""))
    if r["profileName"]:
        print(f"  embedded profile             {r['profileName']}")
    ambient = r.get("ambient") or {}
    if ambient:
        parts = []
        if "cctK" in ambient:
            parts.append(f"{ambient['cctK']:.0f} K")
        if "lux" in ambient:
            parts.append(f"{ambient['lux']:.1f} lux")
        if "tofDistanceM" in ambient:
            parts.append(f"ToF {ambient['tofDistanceM']:.3f} m")
        if "flickerHz" in ambient:
            parts.append(f"{ambient['flickerHz']:.0f} Hz flicker")
        print(f"  rawr: ambient                {' / '.join(parts)}")
    for e in r.get("neutral") or []:
        mark = " <-" if e.get("chosen") else ""
        print(f"  neutral via {e['matrix']:<8}         {e['cctK']} K  "
              f"(xy {e['xy'][0]:.4f} {e['xy'][1]:.4f}){mark}")
    if r.get("neutralErrorMired") is not None:
        print(f"  reference                    {r['referenceK']} K")
        print(f"  neutral error                {r['neutralErrorMired']:+.1f} mired")
    if r.get("sensorErrorMired") is not None:
        print(f"  sensor error                 {r['sensorErrorMired']:+.1f} mired  "
              f"(the correction that cancels it is {-r['sensorErrorMired']:+.1f})")
    print()


def main():
    parser = argparse.ArgumentParser(
        description="Read a DNG's white balance metadata and the CCT its neutral point implies.")
    parser.add_argument("files", nargs="+", help="DNG files")
    parser.add_argument("--reference", type=float, metavar="K",
                        help="CCT of the light the scene was lit by (colour meter or the light's "
                             "calibration), printed as a mired error")
    parser.add_argument("--json", action="store_true", help="one JSON object, for a spreadsheet")
    args = parser.parse_args()

    failed = False
    reports = []
    for name in args.files:
        path = Path(name)
        try:
            reports.append(report(path, args.reference))
        except (OSError, ValueError, struct.error) as error:
            print(f"{name}: {error}", file=sys.stderr)
            failed = True
    if args.json:
        print(json.dumps(reports, indent=2))
    else:
        for r in reports:
            print_report(r)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
